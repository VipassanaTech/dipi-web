<?php
/**
 * @file
 * Dipi App export API — read-only JSON endpoints for the offline Android tablet
 * app (formerly "Dipi Course Viewer"). Machine name stays dh_courseviewer; routes
 * stay /dcv/* so the app's API contract is unchanged. See DCV design spec §5.
 */

include_once(dirname(__FILE__) . "/inc/dcv-api.inc");
include_once(dirname(__FILE__) . "/inc/dcv-bundle.inc");

/** Implements hook_menu(). */
function dh_courseviewer_menu() {
  $items = array();
  $items['dcv/ping'] = array(
    'page callback'   => 'dcv_ping',
    'access callback' => TRUE,
    'type'            => MENU_CALLBACK,
  );
  $items['dcv/login'] = array(
    'page callback'   => 'dcv_login',
    'access callback' => TRUE,
    'type'            => MENU_CALLBACK,
  );
  $items['dcv/courses'] = array(
    'page callback'   => 'dcv_courses',
    'access callback' => 'dcv_api_access',
    'type'            => MENU_CALLBACK,
  );
  $items['dcv/course/%/bundle'] = array(
    'page callback'   => 'dcv_course_bundle',
    'page arguments'  => array(2),
    'access callback' => 'dcv_api_access',
    'type'            => MENU_CALLBACK,
  );
  return $items;
}
